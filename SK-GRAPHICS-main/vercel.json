{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "bindings": [
        { "type": "service", "service": "labzeck-main", "format": "url", "env": "LABZECK_URL" }
      ]
    },
    "labzeck-main": {
      "root": "SK-GRAPHICS-main/Labzeck-main",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
